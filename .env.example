# ─── Vani Backend environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Runtime
NODE_ENV=development            # set to "production" on Render (arms secure cookies + fail-fast checks)
PORT=3001

# Frontend origin (used for CORS + OAuth redirect back to the app)
FRONTEND_URL=http://localhost:8080

# Auth — Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Secret used to sign/verify JWTs. Use a long random string; REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Database — MongoDB Atlas (optional; session logging is skipped if unset)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vani

# AI providers
GROQ_API_KEY=your-groq-api-key       # https://console.groq.com/keys
GEMINI_API_KEY=your-gemini-api-key   # https://aistudio.google.com/apikey

# Realtime media — Agora RTC (https://console.agora.io)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERT=your-agora-app-certificate
